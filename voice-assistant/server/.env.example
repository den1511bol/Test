# Переменные для Railway (Variables). Developer: @yfeeeee
ASSISTANT_TOKEN=длинная-случайная-строка   # тот же токен вводится в Android-приложении

# ИИ, вариант 1 (бесплатный): Groq или любой сервис с OpenAI-совместимым API
LLM_API_KEY=gsk_...                        # ключ из console.groq.com
LLM_MODEL=openai/gpt-oss-120b              # при проблемах: llama-3.3-70b-versatile или qwen/qwen3.8-27b
# LLM_BASE_URL=https://api.groq.com/openai/v1   # по умолчанию Groq

# Вместо Groq можно взять Google Gemini (ключ из aistudio.google.com):
# LLM_API_KEY=ключ-из-AI-Studio
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite

# ИИ, вариант 2 (платный): Claude. Задавайте ВМЕСТО блока выше
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Режим 1 (рекомендуется): мост через бота и юзербот Heroku/Hikka, сессия не хранится
RELAY_BOT_TOKEN=123456:AA...               # токен бота от @BotFather
RELAY_OWNER_ID=123456789                   # ваш Telegram ID (@userinfobot)
RELAY_SECRET=ещё-одна-длинная-строка       # тот же секрет вводится в настройках модуля IfiRelay

# Режим 2 (запасной): прямой вход Telethon. Задавайте ВМЕСТО блока выше
# TG_API_ID=1234567
# TG_API_HASH=abcdef0123456789abcdef0123456789
# TG_SESSION=строка-из-scripts/gen_session.py
